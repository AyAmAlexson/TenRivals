# Copy to `.env` for local development (never commit `.env`).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# Database: prefer one URL (Heroku / Docker), or omit and use PG* for local Postgres.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
PGDATABASE=tenrivals_local_dev
PGUSER=postgres
PGPASSWORD=
PGHOST=localhost
PGPORT=5432

# Optional: comma-separated hosts (e.g. ngrok hostname without scheme).
# EXTRA_ALLOWED_HOSTS=myapp.ngrok-free.app
# Optional: comma-separated full origins (https://...).
# EXTRA_CSRF_TRUSTED_ORIGINS=https://myapp.ngrok-free.app

# Error notifications (comma-separated "Name <email@domain>" or bare emails).
# DJANGO_ADMINS=Ops <ops@tenrivals.com>

# Logging: INFO in production; file handler off on Heroku by default.
# DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_FILE=false

# Optional error tracking.
# SENTRY_DSN=https://...@.ingest.sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.05

# HSTS: start at 0; after HTTPS is verified on the live domain, set e.g. 2592000 (30 days).
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# SESSION_SAVE_EVERY_REQUEST=false

# Local HTTP: set both to false when not using HTTPS.
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Shared Redis URL for IP rate limits across dynos (optional; else in-memory per process).
# RATELIMIT_REDIS_URL=redis://localhost:6379/1

# Emergency: disable django-ratelimit decorators (not recommended).
# RATELIMIT_ENABLE=true
